# Personal Task Station operator environment template
# Copy to .env.host for host-based service, or .env for Docker Compose.

# Required: replace with a long random value, e.g. `openssl rand -hex 32`.
PTS_API_KEY=change-me-generate-a-long-random-key

# Host-based service defaults: private localhost only.
PTS_HOST=127.0.0.1
PTS_PORT=8000
PTS_DATA_DIR=.local/pts-data
PTS_DATABASE_URL=sqlite:///.local/pts-data/personal_task_station.sqlite3

# Docker Compose uses its own internal port 8000 and publishes PTS_PORT.
# PTS_DATA_DIR=.local/docker-data

# Optional HTTPS for direct TLS on the app server. Leave unset for localhost/LAN behind a trusted proxy/tunnel.
# PTS_SSL_CERTFILE=/absolute/path/to/certs/server-cert.pem
# PTS_SSL_KEYFILE=/absolute/path/to/certs/server-key.pem

# Optional mTLS. Requires clients to present a certificate signed by this CA.
# PTS_SSL_CAFILE=/absolute/path/to/certs/ca-cert.pem

# Client/skill TLS trust and mTLS paths.
# PTS_SERVER_CERT_PATH=/absolute/path/to/certs/ca-cert.pem
# PTS_CLIENT_CERT_PATH=/absolute/path/to/certs/client-cert.pem
# PTS_CLIENT_KEY_PATH=/absolute/path/to/certs/client-key.pem

# Optional LiteLLM classifier integration.
# PTS_LITELLM_BASE_URL=https://your-litellm-endpoint
# PTS_LITELLM_MODEL=gpt-5.4
# PTS_LITELLM_API_KEY=

# --------------------------------------------------------------------------
# Automated bill ingestion (email monitoring / poller / webhook / screenshots)
# --------------------------------------------------------------------------

# Mailbox to monitor for bill-related emails (e.g. 2924799749@qq.com).
# QQ mail: host imap.qq.com, port 993, password is the IMAP authorization code
# generated in mail.qq.com -> Settings -> Account -> IMAP/SMTP.
# PTS_IMAP_HOST=imap.qq.com
# PTS_IMAP_PORT=993
# PTS_IMAP_USERNAME=2924799749@qq.com
# PTS_IMAP_PASSWORD=your-imap-auth-code
# PTS_IMAP_FOLDER=INBOX

# Background poll interval in seconds for the monitored mailbox.
# 0 disables the poller; with credentials set, 300 (5 min) is a sane default.
# PTS_EMAIL_POLL_SECONDS=300

# Only process bill-related emails (subject keywords or finance senders with
# zip/pdf attachments). Set to 0 only for debugging raw mailbox parsing.
# PTS_EMAIL_BILL_ONLY=1

# Passwords used to open the encrypted WeChat Pay / Alipay monthly bill zips.
# The password is delivered out-of-band (SMS / email body) on each export.
# PTS_WECHAT_BILL_ZIP_PASSWORD=first6digits
# PTS_ALIPAY_BILL_ZIP_PASSWORD=your-alipay-zip-password
# Or provide a comma-separated list tried in order:
# PTS_BILL_ZIP_PASSWORDS=one,two

# Directory where uploaded screenshots are stored before confirmation.
# PTS_DATA_DIR=.local/pts-data
